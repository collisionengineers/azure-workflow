{
  "mcpServers": {
    "azure-workflow-azure": {
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@3.0.0-beta.29",
        "server",
        "start"
      ],
      "env": {
        "AZURE_MCP_COLLECT_TELEMETRY": "false"
      }
    },
    "azure-workflow-microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    }
  }
}
